# Copy to .env.local and fill in. Never commit .env.local (it is gitignored).

# ── Supabase ──────────────────────────────────────────────────────────
# Local dev:  npx supabase start  →  use the printed API URL + keys.
# Production: your Supabase project's URL and keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY (no NEXT_PUBLIC_ prefix — never sent to the browser).
# Used by manager-only user management and the AI concierge's lead capture.
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI ────────────────────────────────────────────────────────────
# SERVER-ONLY. Powers the public AI concierge at /api/chat.
OPENAI_API_KEY=
